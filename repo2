#include <stdlib.h>
#include <stdio.h>
#include <time.h>

void swap(int* a, int* b) { int t = *a; *a = *b; *b = t; }

int partition(int arr[], int low, int high) {
    int pivot = arr[high], i = low - 1;
    for (int j = low; j < high; j++)
        if (arr[j] < pivot) swap(&arr[++i], &arr[j]);
    swap(&arr[i + 1], &arr[high]);
    return i + 1;
}

void quickSort(int arr[], int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);
        quickSort(arr, low, pi - 1);
        quickSort(arr, pi + 1, high);
    }
}

void generateRandomArray(int arr[], int n, int min, int max) {
    for (int i = 0; i < n; i++)
        arr[i] = rand() % (max - min + 1) + min;
}

int main() {
    FILE *fp = fopen("sorting_times.csv", "w");
    if (!fp) return 1;
    fprintf(fp, "n,Time taken (ms)\n");
    srand(time(NULL));

    for (int n = 5000; n <= 10000; n += 500) {
        int arr[n];
        generateRandomArray(arr, n, 1, 10000);
        clock_t start = clock();
        quickSort(arr, 0, n - 1);
        double time = (double)(clock() - start) / CLOCKS_PER_SEC * 1000;
        printf("%d elements: %.2f ms\n", n, time);
        fprintf(fp, "%d,%.2f\n", n, time);
    }

    fclose(fp);
    return 0;
}
